{
  "name": "reg-visual-builder",
  "version": "0.1.0",
  "private": true,
  "description": "拖拽搭建正则表达式的可视化 Electron 编辑器",
  "author": "ZHIPING XU <zpxu@fudan.edu.cn>",
  "homepage": "https://bennix.github.io/RegAIBuilder/",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,app \"vite --port 5173 --strictPort\" \"wait-on http://localhost:5173 && cross-env ELECTRON_RENDERER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "pack": "vite build && electron-builder --mac dmg --win nsis --linux deb rpm",
    "test:engine": "node --test src/engine.test.mjs",
    "test": "node --test src/engine.test.mjs src/ai-context.test.mjs electron/network.test.cjs"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^37.3.1",
    "electron-builder": "^26.18.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.5",
    "wait-on": "^8.0.4"
  }
}
